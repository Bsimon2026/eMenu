{
  "trailingSlash": false,
  "regions": [
    "bom1"
  ],
  "rewrites": [
    {
      "source": "/llms.txt",
      "destination": "/api/crawl?doc=llms"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/crawl?doc=openapi"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "destination": "/api/crawl?doc=home"
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "destination": "/api/crawl?doc=home"
    },
    {
      "source": "/terms.html",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "destination": "/api/crawl?doc=terms"
    },
    {
      "source": "/privacy.html",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "destination": "/api/crawl?doc=privacy"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/crawl?doc=sitemap"
    },
    {
      "source": "/s/:code",
      "destination": "/api/order?short=1&code=:code"
    },
    {
      "source": "/api/orders",
      "destination": "/api/order"
    },
    {
      "source": "/superadmin",
      "destination": "/superadmin.html"
    },
    {
      "source": "/favicon.ico",
      "destination": "/assets/favicon.ico"
    },
    {
      "source": "/f/:token([A-Za-z0-9_-]{6,40})",
      "destination": "/feedback.html"
    },
    {
      "source": "/:handle([a-z0-9][a-z0-9-]{2,31})/login",
      "destination": "/login.html"
    },
    {
      "source": "/:handle([a-z0-9][a-z0-9-]{2,31})/dashboard",
      "destination": "/app.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/menu",
      "destination": "/menu.html"
    },
    {
      "source": "/digimenu/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/digimenu",
      "destination": "/index.html"
    },
    {
      "source": "/digimenu/:handle([a-z0-9][a-z0-9-]{2,31})",
      "destination": "/api/page/:handle"
    },
    {
      "source": "/:handle([a-z0-9][a-z0-9-]{2,31})",
      "destination": "/api/page/:handle"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/api/crawl?notfound=1"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    }
  ]
}
